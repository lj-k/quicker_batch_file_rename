<!-- 批量重命名器 自定义窗口 XAML 版本：0.06.7 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:qk="https://getquicker.net"
        mc:Ignorable="d"
        Title="批量重命名器"
        Width="1220"
        Height="860"
        MinWidth="1040"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#344054"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#E3E6EB"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#D0D5DD"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="FieldText" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAECF0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#1570EF"
                                BorderBrush="#1570EF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#175CD3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1849A9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TokenButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="#EAF2FF"/>
            <Setter Property="BorderBrush" Value="#BBD4F8"/>
            <Setter Property="Foreground" Value="#175CD3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCEBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C7DFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="批量重命名器"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="左侧配置，右侧点击胶囊插入模板"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="12,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="RealTimeCheck"
                          Content="实时刷新"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                <Button x:Name="BtnPreview"
                        Content="预览"
                        Style="{StaticResource ToolButton}"
                        Margin="0,0,18,0"/>
                <Button x:Name="BtnLoadPreset"
                        Content="载入预设"
                        Style="{StaticResource ToolButton}"/>
                <Button x:Name="BtnSavePreset"
                        Content="保存预设"
                        Style="{StaticResource ToolButton}"
                        Margin="0"/>
            </StackPanel>
        </Grid>

        <Border x:Name="ErrorBanner"
                Grid.Row="1"
                Background="#FEF3F2"
                BorderBrush="#FDA29B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,7"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorBannerText"
                       Foreground="#B42318"
                       TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer x:Name="ConfigPanel"
                      Grid.Row="2"
                      MaxHeight="430"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilterCardTitle" Text="0 过滤器" Style="{StaticResource CardTitle}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <WrapPanel>
                                <TextBlock Text="扩展名列表" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,6,0"/>
                                <TextBox x:Name="FilterExtensionsText" Width="430" Height="48" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource FieldText}" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="分号/逗号/空格/换行分隔；空列表=不过滤" Style="{StaticResource CardHint}" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="决策模式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="FilterModeCombo" Width="140" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="跳过（排除匹配项）" Tag="skip"/>
                                    <ComboBoxItem Content="复制" Tag="copy"/>
                                    <ComboBoxItem Content="移动" Tag="move"/>
                                    <ComboBoxItem Content="重命名" Tag="rename"/>
                                </ComboBox>
                                <Button x:Name="BtnLoadExtPreset" Content="载入扩展名预设" Style="{StaticResource ToolButton}"/>
                                <Button x:Name="BtnSaveExtPreset" Content="保存扩展名预设" Style="{StaticResource ToolButton}" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RootCardTitle" Text="1 根路径" Style="{StaticResource CardTitle}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模式" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="RootModeCombo" Grid.Column="1" Style="{StaticResource FieldCombo}">
                                <ComboBoxItem Content="当前文件夹" Tag="current"/>
                                <ComboBoxItem Content="其他文件夹" Tag="custom"/>
                            </ComboBox>
                            <TextBox x:Name="RootPathText" Grid.Column="2" Style="{StaticResource FieldText}" IsReadOnly="True" Background="#F9FAFB"/>
                            <Button x:Name="BrowseRootButton" Grid.Column="3" Content="浏览…" Style="{StaticResource ToolButton}" Margin="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DateCardTitle" Text="2 日期" Style="{StaticResource CardTitle}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <WrapPanel>
                                <TextBlock Text="日期来源" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DateSourceCombo" Width="170" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="文件名中的日期" Tag="filename"/>
                                    <ComboBoxItem Content="exif拍摄日期" Tag="exif"/>
                                    <ComboBoxItem Content="修改日期" Tag="modified"/>
                                    <ComboBoxItem Content="创建日期" Tag="created"/>
                                </ComboBox>
                                <TextBlock Text="最早起始年份" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="StartYearCombo" Width="90" Style="{StaticResource FieldCombo}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="PreferExifCheck"
                                          Content="文件名日期与EXIF不一致时用EXIF"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="递补" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="1" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="Fallback1Combo" Width="90" Margin="0,0,6,0" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="文件名日期" Tag="filename"/>
                                    <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                                    <ComboBoxItem Content="修改日期" Tag="modified"/>
                                    <ComboBoxItem Content="创建日期" Tag="created"/>
                                    <ComboBoxItem Content="空值" Tag="empty"/>
                                    <ComboBoxItem Content="自定义" Tag="custom"/>
                                    <ComboBoxItem Content="跳过" Tag="skip"/>
                                </ComboBox>
                                <TextBlock Text="2" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="Fallback2Combo" Width="90" Margin="0,0,6,0" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="文件名日期" Tag="filename"/>
                                    <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                                    <ComboBoxItem Content="修改日期" Tag="modified"/>
                                    <ComboBoxItem Content="创建日期" Tag="created"/>
                                    <ComboBoxItem Content="空值" Tag="empty"/>
                                    <ComboBoxItem Content="自定义" Tag="custom"/>
                                    <ComboBoxItem Content="跳过" Tag="skip"/>
                                </ComboBox>
                                <TextBlock Text="3" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="Fallback3Combo" Width="90" Margin="0,0,6,0" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="文件名日期" Tag="filename"/>
                                    <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                                    <ComboBoxItem Content="修改日期" Tag="modified"/>
                                    <ComboBoxItem Content="创建日期" Tag="created"/>
                                    <ComboBoxItem Content="空值" Tag="empty"/>
                                    <ComboBoxItem Content="自定义" Tag="custom"/>
                                    <ComboBoxItem Content="跳过" Tag="skip"/>
                                </ComboBox>
                                <TextBlock Text="4" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="Fallback4Combo" Width="90" Margin="0,0,6,0" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="文件名日期" Tag="filename"/>
                                    <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                                    <ComboBoxItem Content="修改日期" Tag="modified"/>
                                    <ComboBoxItem Content="创建日期" Tag="created"/>
                                    <ComboBoxItem Content="空值" Tag="empty"/>
                                    <ComboBoxItem Content="自定义" Tag="custom"/>
                                    <ComboBoxItem Content="跳过" Tag="skip"/>
                                </ComboBox>
                                <TextBlock Text="5" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="Fallback5Combo" Width="90" Margin="0,0,6,0" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="文件名日期" Tag="filename"/>
                                    <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                                    <ComboBoxItem Content="修改日期" Tag="modified"/>
                                    <ComboBoxItem Content="创建日期" Tag="created"/>
                                    <ComboBoxItem Content="空值" Tag="empty"/>
                                    <ComboBoxItem Content="自定义" Tag="custom"/>
                                    <ComboBoxItem Content="跳过" Tag="skip"/>
                                </ComboBox>
                                <TextBlock Text="自定义值" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FallbackCustomText" Width="110" Style="{StaticResource FieldText}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ChecksumCardTitle" Text="3 校验码" Style="{StaticResource CardTitle}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <WrapPanel Grid.Column="1">
                            <TextBlock Text="算法" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="AlgorithmCombo" Width="100" Style="{StaticResource FieldCombo}">
                                <ComboBoxItem Content="CRC32" Tag="CRC32"/>
                                <ComboBoxItem Content="BLAKE3" Tag="BLAKE3"/>
                                <ComboBoxItem Content="MD5" Tag="MD5"/>
                                <ComboBoxItem Content="SHA-256" Tag="SHA-256"/>
                            </ComboBox>
                            <TextBlock Text="位数" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DigitsText" Width="52" MaxLength="2" Style="{StaticResource FieldText}"/>
                            <TextBlock Text="前缀" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PrefixText" Width="70" Text="[" Style="{StaticResource FieldText}"/>
                            <TextBlock Text="后缀" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SuffixText" Width="70" Text="]" Style="{StaticResource FieldText}"/>
                            <TextBlock x:Name="ChecksumBadge" Text="[CRC32-7f7f7f7f]" Foreground="#175CD3" VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TemplateCardTitle" Text="4 目标路径" Style="{StaticResource CardTitle}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                <RichTextBox x:Name="TemplateEditor" Height="70" BorderThickness="0" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2"/>
                            </Border>
                            <Button x:Name="BtnResetTemplate" Content="恢复默认模板" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,2,0,0">
                    <Button x:Name="BtnTokenRoot" Content="【根路径】" Tag="【根路径】" Style="{StaticResource TokenButton}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,2,0,0">
                    <Button x:Name="BtnTokenYyyy" Content="【日期yyyy】" Tag="【日期yyyy】" Style="{StaticResource TokenButton}"/>
                    <Button x:Name="BtnTokenMm" Content="【日期mm】" Tag="【日期mm】" Style="{StaticResource TokenButton}"/>
                    <Button x:Name="BtnTokenDd" Content="【日期dd】" Tag="【日期dd】" Style="{StaticResource TokenButton}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,2,0,0">
                    <Button x:Name="BtnTokenHash" Content="【校验码】" Tag="【校验码】" Style="{StaticResource TokenButton}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,2,0,0">
                    <Button x:Name="BtnTokenName" Content="【源文件名】" Tag="【源文件名】" Style="{StaticResource TokenButton}"/>
                    <Button x:Name="BtnTokenExt" Content="【扩展名】" Tag="【扩展名】" Style="{StaticResource TokenButton}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="{StaticResource SoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,6">
            <DataGrid x:Name="PreviewGrid"
                      Margin="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECF0"
                      AlternationCount="2"
                      RowHeight="31"
                      ColumnHeaderHeight="34"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="动作" Binding="{Binding [Action]}" Width="68"/>
                    <DataGridTextColumn Header="源路径名" Binding="{Binding [SourcePath]}" Width="2*"/>
                    <DataGridTextColumn Header="目标路径名/文件名" Binding="{Binding [TargetPath]}" Width="3*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding [Details]}"/>
                        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                        <Setter Property="MinHeight" Value="31"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#344054"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                <Setter Property="Background" Value="#FAFBFC"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding [ExecState]}" Value="done">
                                <Setter Property="Background" Value="#ECFDF3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding [HasError]}" Value="True">
                                <Setter Property="Background" Value="#FFF1F0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding [IsPending]}" Value="True">
                                <Setter Property="Background" Value="#FFFAEB"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding [IsSkipped]}" Value="True">
                                <Setter Property="Background" Value="#F2F4F7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Border>

        <!-- RELEASE-EXEC-BEGIN -->
        <Border Grid.Row="4"
                Background="#FFFFFF"
                BorderBrush="{StaticResource SoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="执行配置" Style="{StaticResource CardTitle}" Margin="0,0,12,0"/>
                    <TextBlock Text="并行数量" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ExecParallelCombo" Width="66" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="1" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="5" Tag="5"/>
                        <ComboBoxItem Content="6" Tag="6"/>
                        <ComboBoxItem Content="7" Tag="7"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                    </ComboBox>
                    <CheckBox x:Name="ExecVerifyCheck" Content="执行后校验" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="复制/移动后重新计算目标文件校验码并核对文件名" Style="{StaticResource CardHint}" VerticalAlignment="Center" Margin="0"/>
                </WrapPanel>

                <Button x:Name="BtnExecute"
                        Grid.Column="1"
                        Content="执行"
                        Style="{StaticResource PrimaryButton}"
                        Width="110"
                        IsEnabled="False"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <ProgressBar x:Name="ExecProgress"
                                 Width="180"
                                 Height="6"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="ExecStatusText"
                               Text="执行总数 0；已完成 0；错误 0；传输速度 —；执行速度 —"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- RELEASE-EXEC-END -->

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Progress"
                             Width="140"
                             Height="6"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="准备就绪"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource ToolButton}" Width="80"/>
                <!-- RELEASE-APPLY-BEGIN -->
                <Button x:Name="BtnApply" Content="生成输出" Style="{StaticResource PrimaryButton}" Width="110" IsEnabled="False"/>
                <!-- RELEASE-APPLY-END -->
                <!-- RELEASE-FINISH-BEGIN -->
                <Button x:Name="BtnFinish" Content="完成" Style="{StaticResource PrimaryButton}" Width="100" Margin="8,0,0,0"/>
                <!-- RELEASE-FINISH-END -->
            </StackPanel>
        </Grid>

        <Popup x:Name="PresetPopup"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="#FFFFFF"
                    BorderBrush="{StaticResource FieldBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6"
                    MinWidth="240">
                <StackPanel>
                    <TextBlock Text="选择预设"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="4,2,4,6"/>
                    <ListBox x:Name="PresetListBox"
                             MaxHeight="240"
                             BorderThickness="0"
                             Background="#FFFFFF"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
