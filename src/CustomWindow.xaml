<!-- 批量重命名器 自定义窗口 XAML 版本：0.02 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:qk="https://getquicker.net"
        mc:Ignorable="d"
        Title="批量重命名器"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#344054"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#E3E6EB"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#D0D5DD"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="FieldText" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAECF0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#1570EF"
                                BorderBrush="#1570EF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#175CD3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1849A9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TokenButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="#EAF2FF"/>
            <Setter Property="BorderBrush" Value="#BBD4F8"/>
            <Setter Property="Foreground" Value="#175CD3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCEBFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C7DFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ErrorBanner"
                Grid.Row="0"
                Background="#FEF3F2"
                BorderBrush="#FDA29B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,7"
                Margin="0,0,0,6"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorBannerText"
                       Foreground="#B42318"
                       TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="{StaticResource SoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,6">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="根路径" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="RootModeCombo" Grid.Column="1" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="当前文件夹" Tag="current"/>
                        <ComboBoxItem Content="其他文件夹" Tag="custom"/>
                    </ComboBox>
                    <TextBox x:Name="RootPathText" Grid.Column="2" Style="{StaticResource FieldText}" IsReadOnly="True" Background="#F9FAFB"/>
                    <Button x:Name="BrowseRootButton" Grid.Column="3" Content="浏览…" Style="{StaticResource ToolButton}" Margin="0"/>

                    <TextBlock Grid.Column="5" Text="最早起始年份" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="StartYearCombo" Grid.Column="6" Style="{StaticResource FieldCombo}"/>

                    <TextBlock Grid.Column="8" Text="日期" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DateSourceCombo" Grid.Column="9" Style="{StaticResource FieldCombo}" Margin="0">
                        <ComboBoxItem Content="文件名中的日期" Tag="filename"/>
                        <ComboBoxItem Content="exif拍摄日期" Tag="exif"/>
                        <ComboBoxItem Content="修改日期" Tag="modified"/>
                        <ComboBoxItem Content="创建日期" Tag="created"/>
                    </ComboBox>
                </Grid>

                <WrapPanel Margin="0,0,0,8">
                    <CheckBox x:Name="RealTimeCheck"
                              Content="实时刷新"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                    <Button x:Name="BtnPreview"
                            Content="预览"
                            Style="{StaticResource ToolButton}"
                            Margin="0,0,18,0"/>
                    <CheckBox x:Name="FallbackEnabledCheck"
                              Content="启用缺失递补"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="递补1" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="Fallback1Combo" Width="118" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="文件名日期" Tag="filename"/>
                        <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                        <ComboBoxItem Content="修改日期" Tag="modified"/>
                        <ComboBoxItem Content="创建日期" Tag="created"/>
                    </ComboBox>
                    <TextBlock Text="递补2" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="Fallback2Combo" Width="118" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="文件名日期" Tag="filename"/>
                        <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                        <ComboBoxItem Content="修改日期" Tag="modified"/>
                        <ComboBoxItem Content="创建日期" Tag="created"/>
                    </ComboBox>
                    <TextBlock Text="递补3" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="Fallback3Combo" Width="118" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="文件名日期" Tag="filename"/>
                        <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                        <ComboBoxItem Content="修改日期" Tag="modified"/>
                        <ComboBoxItem Content="创建日期" Tag="created"/>
                    </ComboBox>
                    <TextBlock Text="递补4" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="Fallback4Combo" Width="118" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="文件名日期" Tag="filename"/>
                        <ComboBoxItem Content="EXIF日期" Tag="exif"/>
                        <ComboBoxItem Content="修改日期" Tag="modified"/>
                        <ComboBoxItem Content="创建日期" Tag="created"/>
                    </ComboBox>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="日期缺失值" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MissingModeCombo" Width="130" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="空字符串" Tag="empty"/>
                        <ComboBoxItem Content="自定义字符串" Tag="custom"/>
                    </ComboBox>
                    <TextBox x:Name="MissingText" Width="220" Style="{StaticResource FieldText}"/>
                    <TextBlock Text="（关闭缺失递补时生效）"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="校验码" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="AlgorithmCombo" Width="100" Style="{StaticResource FieldCombo}">
                        <ComboBoxItem Content="CRC32" Tag="CRC32"/>
                        <ComboBoxItem Content="BLAKE3" Tag="BLAKE3"/>
                        <ComboBoxItem Content="MD5" Tag="MD5"/>
                        <ComboBoxItem Content="SHA-256" Tag="SHA-256"/>
                    </ComboBox>
                    <TextBlock Text="位数" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DigitsText" Width="52" MaxLength="2" Style="{StaticResource FieldText}"/>
                    <TextBlock Text="前缀" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PrefixText" Width="90" Text="[" Style="{StaticResource FieldText}"/>
                    <TextBlock Text="后缀" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SuffixText" Width="90" Text="]" Style="{StaticResource FieldText}"/>
                    <TextBlock x:Name="ChecksumBadge"
                               Text="[CRC32-7f7f7f7f]"
                               Foreground="#175CD3"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               MaxWidth="320"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="模板" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,6,0"/>
                    <Border Grid.Column="1"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource FieldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4">
                        <RichTextBox x:Name="TemplateEditor"
                                     Height="64"
                                     BorderThickness="0"
                                     AcceptsReturn="False"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Padding="2"/>
                    </Border>
                </Grid>

                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnLoadPreset" Content="载入预设" Style="{StaticResource ToolButton}"/>
                        <Button x:Name="BtnSavePreset" Content="保存预设" Style="{StaticResource ToolButton}" Margin="0"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button x:Name="BtnTokenYyyy" Content="日期yyyy" Tag="【日期yyyy】" Style="{StaticResource TokenButton}"/>
                        <Button x:Name="BtnTokenMm" Content="日期mm" Tag="【日期mm】" Style="{StaticResource TokenButton}"/>
                        <Button x:Name="BtnTokenDd" Content="日期dd" Tag="【日期dd】" Style="{StaticResource TokenButton}"/>
                        <Button x:Name="BtnTokenRoot" Content="根路径" Tag="【根路径】" Style="{StaticResource TokenButton}"/>
                        <Button x:Name="BtnTokenName" Content="源文件名" Tag="【源文件名】" Style="{StaticResource TokenButton}"/>
                        <Button x:Name="BtnTokenExt" Content="扩展名" Tag="【扩展名】" Style="{StaticResource TokenButton}"/>
                        <Button x:Name="BtnTokenHash" Content="校验码" Tag="【校验码】" Style="{StaticResource TokenButton}"/>
                        <Button x:Name="BtnResetTemplate" Content="恢复默认模板" Style="{StaticResource ToolButton}" Margin="8,0,0,0"/>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="{StaticResource SoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,6,0,6">
            <DataGrid x:Name="PreviewGrid"
                      Margin="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECF0"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#FAFBFC"
                      RowHeight="31"
                      ColumnHeaderHeight="34"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="源路径名" Binding="{Binding [SourcePath]}" Width="2*"/>
                    <DataGridTextColumn Header="目标路径名/文件名" Binding="{Binding [TargetPath]}" Width="3*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding [Details]}"/>
                        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
                        <Setter Property="MinHeight" Value="31"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding [HasError]}" Value="True">
                                <Setter Property="Background" Value="#FFF1F0"/>
                                <Setter Property="Foreground" Value="#B42318"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding [IsPending]}" Value="True">
                                <Setter Property="Background" Value="#FFFAEB"/>
                                <Setter Property="Foreground" Value="#8A5A00"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Progress"
                             Width="140"
                             Height="6"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="准备就绪"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource ToolButton}" Width="80"/>
                <Button x:Name="BtnApply" Content="生成输出" Style="{StaticResource PrimaryButton}" Width="110" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
